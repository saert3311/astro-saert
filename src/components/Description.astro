---
import SectionContainer from "./SectionContainer.astro"
import ServiceCard from "./ServiceCard.astro"
import ListElement from "./ListElement.astro"
import FrontTools from "./FrontTools.astro";
import BackTools from "./BackTools.astro"
import ToolsTools from "./ToolsTools.astro"
import Subtitle from "./Subtitle.astro"

import {getLangFromUrl, useTranslations} from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)
const ITEMS = [
    {
        name: t('description.for'),
        description: t('description.for.text'),
    },
    {
        name: t('description.to'),
        description: t('description.to.text'),
    },
    {
        name: t('description.how'),
        description: t('description.how.text'),
    }
]
---
<SectionContainer id="description">
    <div class="container py-16 md:py-20" id="services">
        <Subtitle>
            {t('description.title')}
        </Subtitle>
        <h3
                class="pt-6 font-header text-xl font-medium lg:text-2xl"
        >
            {t('description.subtitle')}
        </h3>

        <div class="grid grid-cols-1 gap-6 pt-10 sm:grid-cols-2 md:gap-10 md:pt-12">
            <ServiceCard>
                <img
                        src="/assets/img/icon-development-white.svg"
                        alt="development icon"
                        slot="image"
                />
                {t('description.web')}
                <Fragment slot="subtitle">{t('description.web.text')}</Fragment>
            </ServiceCard>
            <ServiceCard>
                <img
                        src="/assets/img/icon-graphics-white.svg"
                        alt="Cloud icon"
                        slot="image"
                />
                {t('description.support')}
                <Fragment slot="subtitle">{t('description.support.text')}</Fragment>
            </ServiceCard>
        </div>
    </div>

    <ol class="items-center sm:flex">
        {ITEMS.map((item, i) => (
                <ListElement key={i}>
                    <Fragment slot="number">{i+1}</Fragment>
                    {item.name}
                    <Fragment slot="description">{item.description}</Fragment>
                </ListElement>
        ))}
    </ol>
    <h4 class="pt-8 font-header text-xl font-medium lg:text-2xl">
        {t("description.iuse")}
    </h4>
    <div class="grid grid-cols-1 gap-6 pt-10 sm:grid-cols-2 md:grid-cols-3 md:gap-10 md:pt-12">
    <FrontTools /><BackTools /><ToolsTools />
    </div>
</SectionContainer>