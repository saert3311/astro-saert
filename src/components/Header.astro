---
import {getLangFromUrl, useTranslations} from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang)
import MenuButton from "@/components/MenuButton.astro"
---
<header class="flex justify-center items-center py-5 w-full xl:w-[1120px] mt-2 mx-auto text-sm md:text-base">
    <nav class="flex flex-row gap-x-10 opacity-80 items-center">
        <a href="#description">{t('nav.tools')}</a>
        <a href="#projects">{t('nav.projects')}</a>
        <a href="#experience">{t('nav.experience')}</a>
        <a href="https://status.trinum.xyz/" rel="nofollow noopener noreferrer" target="_blank">{t('nav.status')}</a>
        <MenuButton>ES</MenuButton>
    </nav>
</header>